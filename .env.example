# Local development only. Copy to .env before running Docker Compose.
STUBLINE_POSTGRES_PASSWORD=postgres
STUBLINE_INVENTORY_DB_PASSWORD=inventory
STUBLINE_TICKETING_DB_PASSWORD=ticketing
STUBLINE_NOTIFICATIONS_DB_PASSWORD=notifications
STUBLINE_TLS_PASSWORD=changeit
STUBLINE_S3_ACCESS_KEY=admin
STUBLINE_S3_SECRET_KEY=secret
STUBLINE_CORS_ORIGINS=
STUBLINE_ADMIN_PORT=8081
STUBLINE_JDBC_URL=jdbc:postgresql://127.0.0.1:5432/ticketing
STUBLINE_DB_USER=ticketing
# Password for the earlier single-database README command; current Compose uses service-specific credentials.
STUBLINE_DB_PASSWORD=stubline
STUBLINE_DB_STRATEGY=ROW_LOCK
# Public browser client settings. Use exact redirect URIs and origins; no client secret is used.
STUBLINE_OAUTH_CLIENT_ID=stubline-web
STUBLINE_OAUTH_REDIRECT_URIS=http://localhost:5173/callback
STUBLINE_OAUTH_WEB_ORIGINS=http://localhost:5173
